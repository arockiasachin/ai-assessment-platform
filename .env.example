# Copy to .env and fill in. Never commit .env.

# Postgres connection used by Prisma
DATABASE_URL="postgresql://user:password@localhost:5432/assessment_platform"

# Secret used to sign session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET=""

# LLM provider: mock | openai | deepseek | anthropic | ollama
# "mock" is deterministic and requires no API key, so tests and CI stay offline.
# This selects the generation/grading provider (chat).
LLM_PROVIDER="mock"

# Embeddings provider: mock | openai | deepseek | anthropic | ollama
# Defaults to LLM_PROVIDER when unset/blank, so existing single-provider configs
# are unchanged. Set it when the chat provider cannot embed. DeepSeek and
# Anthropic expose no embeddings endpoint, so their selection breaks material
# indexing and retrieval unless this points at a provider that can embed.
#
#   LLM_PROVIDER=deepseek            # chat: generation + grading
#   EMBEDDINGS_PROVIDER=openai       # embeddings: material indexing + retrieval
#
# Ollama is a local/self-hosted option if you want to avoid a second paid
# provider, e.g. EMBEDDINGS_PROVIDER=ollama with an embedding model pulled.
EMBEDDINGS_PROVIDER=""

# Request timeout for live providers, in milliseconds.
LLM_TIMEOUT_MS="60000"

# OpenAI-compatible endpoint (OpenAI, OpenRouter, vLLM, LM Studio, ...).
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# DeepSeek (OpenAI-compatible Chat Completions). Select with LLM_PROVIDER="deepseek".
# The canonical model id is "deepseek-flash" (DeepSeek-V4.1-Flash). NOTE: it is a
# moving target — DeepSeek publishes no immutable snapshot id, so it is logged
# per call as the response id + system_fingerprint rather than a fixed version.
# Legacy "deepseek-v4-flash" / "deepseek-chat" / "deepseek-reasoner" are retired
# or deprecated; do not set them here.
# DeepSeek serves no embeddings route, so LLM_PROVIDER="deepseek" cannot power
# material indexing; pair it with EMBEDDINGS_PROVIDER (see above) for retrieval.
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-flash"

# Anthropic has no embeddings endpoint; pair it with EMBEDDINGS_PROVIDER for
# retrieval.
ANTHROPIC_API_KEY=""
ANTHROPIC_BASE_URL="https://api.anthropic.com"
ANTHROPIC_MODEL="claude-3-5-sonnet-latest"

# Local Ollama daemon (no API key).
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"

# Optional cross-provider embedding model override.
EMBEDDING_MODEL=""

# Structured logging threshold: debug | info | warn | error | silent.
# Defaults to info; the test suite defaults to silent.
LOG_LEVEL="info"

# Opt in (local debugging only) to logging LLM prompt/response contents.
# Off by default: prompts can contain student answers and other PII.
LLM_LOG_CONTENT="false"

# Timeout for the /api/health database probe, in milliseconds (clamped 50-10000).
HEALTH_DB_TIMEOUT_MS="1000"
