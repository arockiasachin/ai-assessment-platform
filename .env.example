# Copy to .env and fill in. Never commit .env.

# Postgres connection used by Prisma
DATABASE_URL="postgresql://user:password@localhost:5432/assessment_platform"

# Secret used to sign session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET=""

# LLM provider: mock | openai | anthropic | ollama
# "mock" is deterministic and requires no API key, so tests and CI stay offline.
LLM_PROVIDER="mock"

# Request timeout for live providers, in milliseconds.
LLM_TIMEOUT_MS="60000"

# OpenAI-compatible endpoint (OpenAI, OpenRouter, vLLM, LM Studio, ...).
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Anthropic has no embeddings endpoint; pairing it with retrieval needs a
# separate embedding provider.
ANTHROPIC_API_KEY=""
ANTHROPIC_BASE_URL="https://api.anthropic.com"
ANTHROPIC_MODEL="claude-3-5-sonnet-latest"

# Local Ollama daemon (no API key).
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"

# Optional cross-provider embedding model override.
EMBEDDING_MODEL=""

# Structured logging threshold: debug | info | warn | error | silent.
# Defaults to info; the test suite defaults to silent.
LOG_LEVEL="info"

# Opt in (local debugging only) to logging LLM prompt/response contents.
# Off by default: prompts can contain student answers and other PII.
LLM_LOG_CONTENT="false"

# Timeout for the /api/health database probe, in milliseconds (clamped 50-10000).
HEALTH_DB_TIMEOUT_MS="1000"
