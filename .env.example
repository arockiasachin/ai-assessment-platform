# Copy to .env and fill in. Never commit .env.

# Postgres connection used by Prisma
DATABASE_URL="postgresql://user:password@localhost:5432/assessment_platform"

# Secret used to sign session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET=""

# LLM provider: mock | openai | anthropic | ollama
# "mock" is deterministic and requires no API key, so tests and CI stay offline.
LLM_PROVIDER="mock"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"
