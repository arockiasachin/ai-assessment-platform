generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  TEACHER
  STUDENT
}

enum AssessmentType {
  QUIZ
  ASSIGNMENT
  DESCRIPTIVE
  CODE
  GROUP_PROJECT
}

// The kind of course, which decides which VIT grading regime applies.
//
// `THEORY` and `LAB_EMBEDDED_THEORY` are graded relatively above 10 students; every other
// value is graded absolutely at any size, "irrespective of the class strength". See
// `lib/analytics/grading-bands.ts`.
enum CourseCategory {
  THEORY
  LAB_EMBEDDED_THEORY
  LABORATORY
  PROJECT
  SOFT_SKILLS
  EXTRA_CURRICULAR
  NGCR
}

enum EventType {
  CLASS
  ASSESSMENT
  HOLIDAY
  REMINDER
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  LATE
  GRADED
  RESUBMITTED
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  passwordHash   String
  role           UserRole
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  studentProfile StudentProfile?
  staffProfile   StaffProfile?
}

model StudentProfile {
  id               String         @id @default(cuid())
  userId           String         @unique
  fullName         String
  registerNumber   String         @unique
  profilePicUrl    String?
  // Per-student team-formation attributes and availability, configured once by
  // the instructor. JSON because the attribute keys are instructor-defined and
  // vary per course (formation criteria reference arbitrary attribute names).
  // Shape: { attributes: Record<string, string|number|null>, availability?: string[] }
  formationProfile Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments      Enrollment[]
  courseRatings    CourseRating[]
  submissions      Submission[]

  // Phase 1 assessment spine
  finalGrades             Grade[]
  gradeReviews            GradeReview[]
  aiGradeSuggestions      AIGradeSuggestion[]
  quizAttempts            QuizAttempt[]
  testRuns                TestRun[]
  groupMemberships        GroupMember[]
  peerEvaluationsGiven    PeerEvaluation[]    @relation("PeerEvaluationEvaluator")
  peerEvaluationsReceived PeerEvaluation[]    @relation("PeerEvaluationEvaluatee")
  contributionEvents      ContributionEvent[]
  similarityChecks        SimilarityCheck[]   @relation("SimilarityCheckStudent")
  comparedInSimilarity    SimilarityCheck[]   @relation("SimilarityCheckComparedStudent")
  ltiUserMappings         LtiUserMapping[]
  retakeRequests          RetakeRequest[]
}

model StaffProfile {
  id                 String           @id @default(cuid())
  userId             String           @unique
  fullName           String
  empId              String           @unique
  profilePicUrl      String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  offerings          CourseOffering[] @relation("TeacherOfferings")
  createdAssessments Assessment[]     @relation("AssessmentCreator")
  gradedSubmissions  Submission[]     @relation("SubmissionGrader")

  // Phase 1 assessment spine
  createdMaterials      Material[]      @relation("MaterialCreatedBy")
  createdRubrics        Rubric[]        @relation("RubricCreatedBy")
  reviewedReviews       GradeReview[]   @relation("GradeReviewReviewer")
  assignedReviews       GradeReview[]   @relation("GradeReviewAssignee")
  approvedGrades        Grade[]
  publishedQuestions    Question[]      @relation("QuestionPublisher")
  decidedRetakeRequests RetakeRequest[] @relation("RetakeRequestDecider")
}

model Course {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  description String?
  credits     Int              @default(3)
  // Which VIT grading regime this course uses. **Nullable, and null is not "theory".**
  // The platform cannot infer a course's category from its data, so an unset value falls
  // back to absolute bands with a notice asking for it — guessing `THEORY` would silently
  // put a laboratory course on relative bands, which is the failure this column exists to
  // prevent. See `resolveRegimeForCourse`.
  category    CourseCategory?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  offerings   CourseOffering[]
  assessments Assessment[]
  materials   Material[]
}

model ClassRoom {
  id             String           @id @default(cuid())
  code           String           @unique
  name           String
  academicYear   Int
  section        String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  offerings      CourseOffering[]
  calendarEvents CalendarEvent[]
  assessments    Assessment[]
}

model CourseOffering {
  id                  String          @id @default(cuid())
  courseId            String
  classId             String
  teacherId           String
  term                String
  academicYear        Int
  studentLimit        Int             @default(40)
  registrationOpenAt  DateTime?
  registrationCloseAt DateTime?
  startsOn            DateTime?
  endsOn              DateTime?
  // Retention anchor. Null means "results not published", so no student work
  // for this offering may be purged. Set once, by an explicit teacher action
  // (`POST /api/teacher/offerings/[offeringId]/results`); the purge clock is
  // `resultsPublishedAt + 15 days`, enforced server-side. Offering-level rather
  // than per-enrollment because results are published for a whole course
  // cohort at one moment, and the policy speaks of the whole course.
  resultsPublishedAt  DateTime?
    // Per-offering analytics settings. JSON so the intervention and item-analysis
    // threshold keys can evolve without a migration per threshold. Any missing
    // key falls back to the code defaults in lib/analytics/{alerts,item-analysis}.
    // Shape: { intervention?: Partial<InterventionThresholds>, itemAnalysis?: Partial<ItemAnalysisThresholds> }
    analyticsSettings   Json?
    // Course grading policy. JSON for the same reason as `analyticsSettings`, but
    // note what is deliberately NOT stored: **category membership**. Only the
    // policy is persisted — the CAT/FAT split, which assessment is the final one,
    // and the FAT gate — and the category's assessment list is derived from this
    // offering's assessments at read time (lib/grading/offering-config.ts).
    // Storing `assessmentIds` would hard-bind the config to the assessment set at
    // save time, so a teacher adding an assessment afterwards would silently drop
    // it from every calculation.
    // Shape: { catWeight, fatWeight, finalAssessmentId, minimumCatPercent,
    //          minimumCatCompletionRatio? } — validated by lib/contracts/courses.ts.
    // Null means "not configured"; readers fall back to DEFAULT_CATEGORY_WEIGHTS
    // (CAT 40 / FAT 60) and DEFAULT_FAT_MINIMUM_CAT_PERCENT (30).
    gradingConfig       Json?
  course              Course          @relation(fields: [courseId], references: [id], onDelete: Restrict)
  classRoom           ClassRoom       @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher             StaffProfile    @relation("TeacherOfferings", fields: [teacherId], references: [id], onDelete: Restrict)
  enrollments         Enrollment[]
  assessments         Assessment[]
  calendarEvents      CalendarEvent[]
  materials           Material[]
  groups              Group[]
  ratings             CourseRating[]

  @@unique([courseId, classId, teacherId, term, academicYear])
  @@index([classId, courseId])
  @@index([resultsPublishedAt])
}

model Enrollment {
  id         String         @id @default(cuid())
  studentId  String
  offeringId String
  enrolledAt DateTime       @default(now())
  status     String         @default("active")
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  offering   CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@unique([studentId, offeringId])
  @@index([offeringId])
}

model CourseRating {
  id         String         @id @default(cuid())
  offeringId String
  studentId  String
  rating     Int
  comment    String?
  // Set by the retention purge when the free-text comment was redacted. The
  // numeric rating is retained for aggregate reporting.
  purgedAt   DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  offering   CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([offeringId, studentId])
  @@index([offeringId])
  @@index([studentId])
}

model Assessment {
  id             String          @id @default(cuid())
  offeringId     String
  courseId       String
  classId        String
  title          String
  type           AssessmentType
  dueDate        DateTime
  maxMarks       Int
  createdById    String
  // Per-assessment quiz attempt cap. Null means "fall back to the
  // QUIZ_MAX_ATTEMPTS override, then the 3-attempt default".
  maxAttempts    Int?
  // When this assessment became visible to students. Null means released to
  // nobody, so it is absent from a student's calendar and planner while staying
  // visible to its teacher.
  //
  // This is "this assessment is visible", which is **not** either of the two
  // nearby publish concepts, and it is deliberately not called `publishedAt` so a
  // future reader cannot wire the wrong one:
  //   - `CourseOffering.resultsPublishedAt` is the *retention anchor* and starts
  //     the purge clock, for a whole cohort at once.
  //   - `Grade.publishedAt` is per-*student*: whether one mark has been released.
  // Additive and nullable, so no backfill and no data migration are needed.
  releasedAt     DateTime?
  // How a student may obtain another graded sitting. Defaults to `FIXED`, which is what the
  // platform already did via `maxAttempts` — so no assessment changes behaviour by gaining this
  // column.
  retakePolicy   RetakePolicy    @default(FIXED)
  // The cap on *retakes* rather than total sittings, for the fixed policy. Null means "fall back
  // to `maxAttempts`", so a teacher who sets nothing sees exactly today's behaviour.
  //
  // Separate from `maxAttempts` because the two answer different questions and the UI copy
  // cannot be honest with one number: "one retake" after the first sitting is
  // `maxAttempts = 2`, which reads as two attempts to a teacher who typed "1".
  retakesAllowed Int?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  offering       CourseOffering  @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  course         Course          @relation(fields: [courseId], references: [id], onDelete: Restrict)
  classRoom      ClassRoom       @relation(fields: [classId], references: [id], onDelete: Restrict)
  createdBy      StaffProfile    @relation("AssessmentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  submissions    Submission[]
  calendarLinks  CalendarEvent[]

  // Phase 1 assessment spine
  rubric             Rubric?
  questions          Question[]
  quizAttempts       QuizAttempt[]
  codeTask           CodeTask?
  aiGradeSuggestions AIGradeSuggestion[]
  gradeReviews       GradeReview[]
  finalGrades        Grade[]
  similarityChecks   SimilarityCheck[]
  retakeRequests     RetakeRequest[]

  @@index([offeringId, dueDate])
  @@index([courseId, classId])
}

model Submission {
  id           String           @id @default(cuid())
  assessmentId String
  studentId    String
  submittedAt  DateTime?
  status       SubmissionStatus @default(DRAFT)
  contentText  String?
  artifactUrl  String?
  gradedAt     DateTime?
  gradedById   String?
  feedback     String?
  // Set by the retention purge when this submission's student-authored content
  // was redacted. Null means the row has not been purged. Retained feedback is
  // teacher-authored and considered part of the academic record.
  purgedAt     DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  assessment   Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student      StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  gradedBy     StaffProfile?    @relation("SubmissionGrader", fields: [gradedById], references: [id], onDelete: SetNull)

  // Phase 1 assessment spine
  versions           SubmissionVersion[]
  aiGradeSuggestions AIGradeSuggestion[]
  testRuns           TestRun[]

  @@unique([assessmentId, studentId])
  @@index([studentId, status])
}

model CalendarEvent {
  id           String          @id @default(cuid())
  classId      String?
  offeringId   String?
  assessmentId String?
  title        String
  description  String?
  eventType    EventType
  startAt      DateTime
  endAt        DateTime?
  isUpcoming   Boolean         @default(true)
  createdAt    DateTime        @default(now())
  classRoom    ClassRoom?      @relation(fields: [classId], references: [id], onDelete: SetNull)
  offering     CourseOffering? @relation(fields: [offeringId], references: [id], onDelete: SetNull)
  assessment   Assessment?     @relation(fields: [assessmentId], references: [id], onDelete: SetNull)

  @@index([startAt, isUpcoming])
  @@index([classId, offeringId])
}

// ---------------------------------------------------------------------------
// Phase 1 — assessment spine.
//
// The grading pipeline (AIGradeSuggestion -> GradeReview -> Grade, all audited
// through AuditLog) is the single grade store. The legacy `AssessmentGrade`
// duplicate was retired; manual marks now publish into `Grade` directly.
// ---------------------------------------------------------------------------

enum MaterialKind {
  DOCUMENT
  SLIDE_DECK
  VIDEO
  TRANSCRIPT
  LINK
  OTHER
}

enum QuestionType {
  MULTIPLE_CHOICE
  MULTIPLE_SELECT
  TRUE_FALSE
  SHORT_ANSWER
  ESSAY
  CODE
}

enum QuizAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
  EXPIRED
  ABANDONED
}

// Whether a quiz sitting is graded work or practice.
//
// Practice exists because the retake surface needs somewhere to send a student that is not a
// graded slot — before this, "practise" was indistinguishable from "sit the assessment again".
enum QuizAttemptKind {
  GRADED
  PRACTICE
}

// How a student may obtain another graded sitting beyond their first.
//
// `FIXED` is the default because it is what the platform already does: `maxAttempts` allows a
// fixed number of sittings, and nothing before this column gated them. `APPROVAL` requires an
// approved `RetakeRequest`, which is the teacher-defined variant the retake spec asked for.
// `NONE` means one graded sitting only, whatever `maxAttempts` says.
enum RetakePolicy {
  NONE
  FIXED
  APPROVAL
}

// A student's request for another graded sitting, and the teacher's decision.
//
// Deliberately a record rather than a flag: an approval is a teacher action on a student's
// record, so it carries who decided it and when, and it writes an `AuditLog` row like every
// other high-trust mutation. The shape mirrors `GradeReview` — the closest existing
// pending→decision record — rather than inventing a second pattern.
enum RetakeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model RetakeRequest {
  id           String              @id @default(cuid())
  assessmentId String
  studentId    String
  status       RetakeRequestStatus @default(PENDING)
  // Null until a teacher decides. Kept as a plain relation so the record survives the teacher's
  // departure, like every other audit-bearing model here.
  decidedById  String?
  decidedAt    DateTime?
  // The student's own words, and the teacher's, so a decision has context later.
  requestNote  String?
  decisionNote String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  assessment   Assessment          @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student      StudentProfile      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  decidedBy    StaffProfile?       @relation("RetakeRequestDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  // One request per student per assessment. A rejection does not delete the row — the student
  // asks again by reverting it to PENDING, which keeps the decision history on one record rather
  // than growing a pile of rejected attempts.
  @@unique([assessmentId, studentId])
  @@index([status, createdAt])
  @@index([studentId])
}

enum GradeReviewStatus {
  PENDING
  AUTO_ACCEPTED
  NEEDS_REVIEW
  OVERRIDDEN
  REJECTED
}

enum GradeSource {
  AI_SUGGESTED
  TEACHER_OVERRIDE
  AUTO
  IMPORTED
}

enum TestRunStatus {
  QUEUED
  RUNNING
  PASSED
  FAILED
  ERROR
  TIMEOUT
}

enum GroupStatus {
  FORMING
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum PeerEvaluationStatus {
  DRAFT
  SUBMITTED
}

enum MilestoneStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  MISSED
}

enum ContributionEventType {
  COMMIT
  PULL_REQUEST
  ISSUE
  REVIEW
  MANUAL
  OTHER
}

enum SimilarityVerdict {
  PENDING
  FLAGGED
  CLEARED
}

// Course material and its pgvector-backed retrieval chunks. The embedding
// column stays `Unsupported` so the datamodel validates without a live
// Postgres; embeddings are read and written through raw SQL in lib/vector.
model Material {
  id          String          @id @default(cuid())
  courseId    String
  offeringId  String?
  createdById String?
  title       String
  kind        MaterialKind    @default(DOCUMENT)
  sourceUrl   String?
  mimeType    String?
  contentText String?
  metadata    Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  course      Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  offering    CourseOffering? @relation(fields: [offeringId], references: [id], onDelete: SetNull)
  createdBy   StaffProfile?   @relation("MaterialCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  chunks      MaterialChunk[]

  @@index([courseId, createdAt])
  @@index([offeringId])
}

model MaterialChunk {
  id             String                       @id @default(cuid())
  materialId     String
  chunkIndex     Int
  content        String
  tokenCount     Int?
  embeddingModel String?
  embedding      Unsupported("vector(1536)")?
  metadata       Json?
  createdAt      DateTime                     @default(now())
  material       Material                     @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([materialId, chunkIndex])
  @@index([materialId])
}

// The rubric is the binding grading contract. Criteria carry the point ceiling
// and weight; the model may not score outside them.
model Rubric {
  id            String            @id @default(cuid())
  assessmentId  String?           @unique
  courseId      String?
  createdById   String?
  title         String
  description   String?
  maxPoints     Decimal?          @db.Decimal(7, 2)
  promptVersion String            @default("v1")
  metadata      Json?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  assessment    Assessment?       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  createdBy     StaffProfile?     @relation("RubricCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  criteria      RubricCriterion[]

  @@index([courseId])
}

model RubricCriterion {
  id          String              @id @default(cuid())
  rubricId    String
  order       Int
  label       String
  description String?
  levelsJson  Json?
  weight      Float               @default(1)
  maxPoints   Decimal             @db.Decimal(6, 2)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  rubric      Rubric              @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  suggestions AIGradeSuggestion[]

  @@unique([rubricId, order])
  @@index([rubricId])
}

// One row per rubric criterion (or per quiz response) per suggestion. Carries
// the full explainability envelope required by the product spec.
model AIGradeSuggestion {
  id                String           @id @default(cuid())
  // Monotonic, database-assigned insertion order. `createdAt` alone cannot
  // break a same-millisecond tie, so "latest suggestion per bucket" orders on
  // this instead. Additive with a sequence default, so existing rows backfill
  // in their physical insert order.
  seq               Int              @default(autoincrement())
  assessmentId      String
  studentId         String
  submissionId      String?
  quizResponseId    String?
  rubricCriterionId String?
  criterionLabel    String?
  suggestedPoints   Decimal          @db.Decimal(6, 2)
  maxPoints         Decimal?         @db.Decimal(6, 2)
  rationale         String
  evidence          String?
  confidence        Float
  model             String
  promptVersion     String
  promptTokens      Int?
  completionTokens  Int?
  latencyMs         Int
  rawResponse       Json?
  // Set by the retention purge when the rationale and quoted evidence were
  // redacted. Scores, model, and token counts are retained for provenance.
  purgedAt          DateTime?
  createdAt         DateTime         @default(now())
  assessment        Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student           StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  submission        Submission?      @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  quizResponse      QuizResponse?    @relation(fields: [quizResponseId], references: [id], onDelete: Cascade)
  rubricCriterion   RubricCriterion? @relation(fields: [rubricCriterionId], references: [id], onDelete: SetNull)

  @@index([assessmentId, studentId])
  @@index([submissionId])
  @@index([quizResponseId])
  @@index([rubricCriterionId])
}

model GradeReview {
  id            String            @id @default(cuid())
  assessmentId  String
  studentId     String
  status        GradeReviewStatus @default(PENDING)
  assignedToId  String?
  reviewerId    String?
  notes         String?
  decisionsJson Json?
  decidedAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  assessment    Assessment        @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student       StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignedTo    StaffProfile?     @relation("GradeReviewAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  reviewer      StaffProfile?     @relation("GradeReviewReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  grade         Grade?

  @@unique([assessmentId, studentId])
  @@index([status, createdAt])
  @@index([assignedToId])
}

// Single source of truth for a published/publishable grade.
model Grade {
  id             String         @id @default(cuid())
  assessmentId   String
  studentId      String
  reviewId       String?        @unique
  points         Decimal        @db.Decimal(7, 2)
  maxPoints      Decimal        @db.Decimal(7, 2)
  percentage     Float?
  source         GradeSource    @default(AI_SUGGESTED)
  approvedById   String?
  overrideReason String?
  publishedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  assessment     Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  review         GradeReview?   @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  approvedBy     StaffProfile?  @relation(fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([assessmentId, studentId])
  @@index([studentId])
  @@index([publishedAt])
}

// Generic, append-only audit trail for grade state transitions and other
// high-trust mutations. Actor is stored as a plain id/role so the log survives
// user deletion and stays usable for any entity.
model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  actorId    String?
  actorRole  String?
  before     Json?
  after      Json?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId])
}

model Question {
  id               String           @id @default(cuid())
  assessmentId     String
  type             QuestionType     @default(MULTIPLE_CHOICE)
  order            Int
  prompt           String
  explanation      String?
  subtopic         String?
  difficulty       Float?
  points           Decimal          @default(1) @db.Decimal(6, 2)
  timeLimitSeconds Int?
  // Explicit draft/published state for LLM-generated questions. `null` on rows
  // created before this column existed (and on hand-authored questions); readers
  // fall back to the legacy `metadata.generationStatus` envelope, then to
  // "published" for a non-generated question.
  status           String?
  publishedAt      DateTime?
  publishedById    String?
  metadata         Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  assessment       Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  publishedBy      StaffProfile?    @relation("QuestionPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  options          QuestionOption[]
  responses        QuizResponse[]

  @@unique([assessmentId, order])
  @@index([assessmentId])
  @@index([subtopic])
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  order      Int
  text       String
  isCorrect  Boolean  @default(false)
  rationale  String?
  createdAt  DateTime @default(now())
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, order])
  @@index([questionId])
}

model QuizAttempt {
  id            String            @id @default(cuid())
  assessmentId  String
  studentId     String
  attemptNumber Int               @default(1)
  status        QuizAttemptStatus @default(IN_PROGRESS)
  // Whether this sitting counts as graded work or as practice.
  //
  // Only `GRADED` attempts count against `Assessment.maxAttempts` and contribute to analytics;
  // a `PRACTICE` sitting from the retake surface is recorded so the student can see their
  // history, but must not consume a graded slot or move the cohort's numbers. Before this
  // column existed, "practice" was indistinguishable from "graded", so exercising it silently
  // burned an attempt — see `lib/quiz-attempts/kinds.ts`, which is the single place the rule
  // lives.
  //
  // Defaults to `GRADED`, which is both the safe value and the correct reading of every row
  // that predates the column: no backfill is needed.
  kind          QuizAttemptKind   @default(GRADED)
  score         Decimal?          @db.Decimal(7, 2)
  maxScore      Decimal?          @db.Decimal(7, 2)
  startedAt     DateTime          @default(now())
  submittedAt   DateTime?
  expiresAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  assessment    Assessment        @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student       StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  responses     QuizResponse[]

  // Kind-scoped numbering, so practice and graded sittings each run their own sequence.
  //
  // The previous constraint was `[assessmentId, studentId, attemptNumber]` — global across
  // kinds — which would collide the moment a student practised before their first graded
  // sitting: practice #1 and graded #1 would both want `attemptNumber = 1`. Sharing the
  // sequence instead was worse, because a student who practised three times would see their
  // first graded attempt labelled "#4". Existing rows are all `GRADED`, so they already satisfy
  // this constraint.
  @@unique([assessmentId, studentId, kind, attemptNumber])
  // Replaces the old `[assessmentId, studentId]` index: the leading columns are the same, so it
  // serves every query that index did, and adds `kind`/`status` for the two hot filters
  // (counting a student's graded sittings, and finding their in-progress one).
  @@index([assessmentId, studentId, kind, status])
  @@index([status])
}

model QuizResponse {
  id                 String              @id @default(cuid())
  attemptId          String
  questionId         String
  selectedOptionIds  Json?
  answerText         String?
  isCorrect          Boolean?
  pointsAwarded      Decimal?            @db.Decimal(6, 2)
  rationale          String?
  timeSpentMs        Int?
  // Set by the retention purge when the student's answer content was redacted.
  purgedAt           DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  attempt            QuizAttempt         @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question           Question            @relation(fields: [questionId], references: [id], onDelete: Cascade)
  aiGradeSuggestions AIGradeSuggestion[]

  @@unique([attemptId, questionId])
  @@index([questionId])
}

model CodeTask {
  id               String            @id @default(cuid())
  assessmentId     String?           @unique
  language         String
  instructions     String?
  starterCode      String?
  timeLimitMs      Int               @default(5000)
  memoryLimitMb    Int               @default(256)
  metadata         Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  assessment       Assessment?       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  testCases        TestCase[]
  testRuns         TestRun[]
  similarityChecks SimilarityCheck[]
}

model TestCase {
  id             String   @id @default(cuid())
  codeTaskId     String
  order          Int
  name           String
  description    String?
  category       String   @default("unit")
  input          String?
  expectedOutput String?
  isHidden       Boolean  @default(true)
  points         Decimal  @default(1) @db.Decimal(6, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  codeTask       CodeTask @relation(fields: [codeTaskId], references: [id], onDelete: Cascade)

  @@unique([codeTaskId, order])
  @@index([codeTaskId])
}

model TestRun {
  id           String         @id @default(cuid())
  codeTaskId   String
  studentId    String
  submissionId String?
  status       TestRunStatus  @default(QUEUED)
  language     String
  sourceCode   String?
  passedCount  Int            @default(0)
  failedCount  Int            @default(0)
  totalCount   Int            @default(0)
  coverage     Float?
  resultsJson  Json?
  stdout       String?
  stderr       String?
  runtimeMs    Int?
  queuedAt     DateTime       @default(now())
  startedAt    DateTime?
  finishedAt   DateTime?
  // Set by the retention purge when the run's artifacts were redacted.
  purgedAt     DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  codeTask     CodeTask       @relation(fields: [codeTaskId], references: [id], onDelete: Cascade)
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  submission   Submission?    @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  @@index([codeTaskId, studentId])
  @@index([status, queuedAt])
}

model Group {
  id                 String              @id @default(cuid())
  offeringId         String
  name               String
  projectTitle       String?
  status             GroupStatus         @default(FORMING)
  metadata           Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  offering           CourseOffering      @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  members            GroupMember[]
  peerEvaluations    PeerEvaluation[]
  contributionEvents ContributionEvent[]
  milestones         Milestone[]

  @@unique([offeringId, name])
  @@index([offeringId, status])
}

model GroupMember {
  id                   String         @id @default(cuid())
  groupId              String
  studentId            String
  role                 String?
  adjustmentFactor     Float?
  selfAdjustmentFactor Float?
  joinedAt             DateTime       @default(now())
  leftAt               DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  group                Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student              StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([groupId, studentId])
  @@index([studentId])
}

model PeerEvaluation {
  id           String               @id @default(cuid())
  groupId      String
  evaluatorId  String
  evaluateeId  String
  status       PeerEvaluationStatus @default(DRAFT)
  dimensions   Json
  overallScore Float?
  comments     String?
  submittedAt  DateTime?
  // Set by the retention purge when the confidential free-text comments were
  // redacted. Numeric dimensions/scores are retained for adjustment history.
  purgedAt     DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  group        Group                @relation(fields: [groupId], references: [id], onDelete: Cascade)
  evaluator    StudentProfile       @relation("PeerEvaluationEvaluator", fields: [evaluatorId], references: [id], onDelete: Cascade)
  evaluatee    StudentProfile       @relation("PeerEvaluationEvaluatee", fields: [evaluateeId], references: [id], onDelete: Cascade)

  @@unique([groupId, evaluatorId, evaluateeId])
  @@index([groupId, evaluateeId])
}

model ContributionEvent {
  id         String                @id @default(cuid())
  groupId    String
  studentId  String?
  type       ContributionEventType
  source     String?
  externalId String?
  summary    String?
  weight     Float                 @default(1)
  occurredAt DateTime
  metadata   Json?
  createdAt  DateTime              @default(now())
  group      Group                 @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student    StudentProfile?       @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([groupId, occurredAt])
  @@index([studentId])
}

model Milestone {
  id          String          @id @default(cuid())
  groupId     String
  title       String
  description String?
  status      MilestoneStatus @default(PLANNED)
  weight      Float           @default(1)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  group       Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, dueDate])
}

model SimilarityCheck {
  id                String            @id @default(cuid())
  assessmentId      String?
  codeTaskId        String?
  studentId         String
  comparedStudentId String
  similarity        Float
  verdict           SimilarityVerdict @default(PENDING)
  evidence          Json?
  checkedAt         DateTime          @default(now())
  createdAt         DateTime          @default(now())
  assessment        Assessment?       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  codeTask          CodeTask?         @relation(fields: [codeTaskId], references: [id], onDelete: Cascade)
  student           StudentProfile    @relation("SimilarityCheckStudent", fields: [studentId], references: [id], onDelete: Cascade)
  comparedStudent   StudentProfile    @relation("SimilarityCheckComparedStudent", fields: [comparedStudentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, codeTaskId, studentId, comparedStudentId])
  @@index([assessmentId])
  @@index([codeTaskId])
}

model SubmissionVersion {
  id            String     @id @default(cuid())
  submissionId  String
  versionNumber Int
  contentText   String?
  artifactUrl   String?
  wordCount     Int?
  // Set by the retention purge when this version's student content was redacted.
  purgedAt      DateTime?
  createdAt     DateTime   @default(now())
  submission    Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, versionNumber])
  @@index([submissionId])
}

// ---------------------------------------------------------------------------
// LTI 1.3 Assignment & Grade Services registration and user mapping.
//
// SECRETS ARE NOT STORED HERE. There is deliberately no private-key column:
// `privateKeyRef` is an opaque pointer (an env-var name, secret-manager ARN, or
// key-vault id); the PEM itself stays in the environment/secret store and is
// never persisted in the database.
// ---------------------------------------------------------------------------

model LtiRegistration {
  id             String           @id @default(cuid())
  platformIssuer String
  clientId       String
  deploymentId   String
  keyId          String
  /**
   * Opaque reference to the signing key (env var name / secret-manager id). Never the key.
   */
  privateKeyRef  String?
  lineItemsUrl   String?
  scopes         String[]         @default([])
  name           String?
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  userMappings   LtiUserMapping[]

  @@unique([platformIssuer, clientId, deploymentId])
  @@index([isActive])
}

model LtiUserMapping {
  id             String          @id @default(cuid())
  registrationId String
  studentId      String
  /**
   * The platform-side user id the LMS sends in an AGS score payload.
   */
  ltiUserId      String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  registration   LtiRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  student        StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([registrationId, ltiUserId])
  @@unique([registrationId, studentId])
  @@index([studentId])
}
